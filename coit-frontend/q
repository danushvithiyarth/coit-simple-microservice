version: 0.0
os: linux
files:
  - source: /
    destination: /home/ubuntu/
    overwrite: true
permissions:
  - object: /home/ubuntu/
    pattern: "**"
    owner: root
    group: root
    mode: 755
hooks:
  AfterInstall:
    - location: script/installationscript.sh
      timeout: 300
      runas: root
  ApplicationStart:
    - location: script/startserver.sh
      timeout: 300
      runas: root
